[Unit]
Description=StoryFork interactive stories
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=amanzholov
WorkingDirectory=/home/amanzholov/storyfork/current
Environment=PATH=/home/amanzholov/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/home/amanzholov/storyfork/shared/production.env
ExecStart=/home/amanzholov/storyfork/current/.venv/bin/uvicorn src.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
