# Server-only configuration. Copy to .env; never put credentials in VITE_* variables.
LLM_PROVIDER=vertex
GOOGLE_CLOUD_PROJECT=YOUR_PROJECT_ID
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash
# Or configure one of the supported API-key providers:
# GEMINI_API_KEY=
# NVIDIA_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# Optional local browser override for the offline audio renderer:
# STORYFORK_CHROME_EXECUTABLE=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Export STORYFORK_HOST or STORYFORK_PORT before running scripts/start.sh to change its binding.
