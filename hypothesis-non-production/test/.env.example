# Change these four values to swap models. Scene code never needs changes.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.1-flash-lite
LLM_API_KEY=replace-with-your-Google-AI-Studio-key
# Optional second Gemini key for StoryFork retries on HTTP 429.
# GEMINI_API_KEY_SECONDARY=replace-with-your-second-Gemini-key
# STORYFORK_MODEL=gemini-3.1-flash-lite

# Any OpenAI-compatible server, including local llama.cpp or LM Studio.
# LLM_PROVIDER=openai
# LLM_MODEL=local-model
# LLM_BASE_URL=http://127.0.0.1:18327/v1
# LLM_API_KEY=optional-provider-key
